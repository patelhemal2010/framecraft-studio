# FrameCraft Studio Environment Configuration

# Backend API
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Docker or local)
DATABASE_URL=postgresql://framecraft:framecraft_secret_password@localhost:5432/framecraft_db?schema=public

# Authentication & Security
JWT_SECRET=super_secret_framecraft_jwt_key_at_least_32_characters_long_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=framecraft_cookie_secret_key_2026

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
MAX_PHOTOS_PER_PROJECT=30

# Web Client
VITE_API_URL=http://localhost:4000/api/v1
