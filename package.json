{
  "name": "framecraft-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@framecraft/web",
    "dev:api": "npm run dev --workspace=@framecraft/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@framecraft/shared && npm run build --workspace=@framecraft/web",
    "build:api": "npm run build --workspace=@framecraft/shared && npm run build --workspace=@framecraft/api",
    "start:api": "npm run start --workspace=@framecraft/api",
    "prisma:push": "npm run prisma:push --workspace=@framecraft/api",
    "prisma:seed": "npm run prisma:seed --workspace=@framecraft/api",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspace=@framecraft/shared && npm run test --workspace=@framecraft/web",
    "test:e2e": "npm run test:e2e --workspace=@framecraft/web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
